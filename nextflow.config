params {

    config_profile_name= 'Metabolomics Datatype Course'
    config_profile_description = 'MONA and DSP metabolomics data processing training'

    outdir = 'results'

    config_profile_name        = 'Metabonaut example dataset'
    config_profile_description = 'Example data from Metabonaut.'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 4
    max_memory = '8.GB'
    max_time   = '6.h'

    // Input data
    input  = 'data/MTBLS8735/samplesheet.csv'
    // Only one charge
    // algorithm_ffm_charge_upper_bound_featurefindermetabo_openms=1

    // identification related

    // identification = true
    // run_ms2query = true
    // run_sirius = true


    // Default peakpickerhires_openms
