    // algorithm_epd_width_filtering_featurefindermetabo_openms = "fixed"
    // algorithm_epd_min_fwhm_featurefindermetabo_openms = 1.0
    // algorithm_epd_max_fwhm_featurefindermetabo_openms = 60.0
